# Optional. The server also checks the local OpenAI.txt path already configured for this build.
OPENAI_API_KEY_FILE=/absolute/path/to/OpenAI.txt
PORT=8787

# Evidence Safari engine: reuse the OpenAI key above; add raw web search credentials.
PERPLEXITY_API_KEY_FILE=/absolute/path/to/Perplexity.txt
# Or set PERPLEXITY_API_KEY directly in the server environment.
# Optional backend-to-backend HTTP access. CLI works without this token.
# EVIDENCE_SAFARI_TOKEN=choose-a-long-random-secret

# Category doodles are static assets. Safari does not call an image API.

# Optional for local development; required at build time for the production canvas.
# An active 100-day trial key supports production evaluation.
# On Vercel, set this in the Production environment before building/deploying.
# This is a public, domain-scoped SDK licence key, not a server secret.
# VITE_TLDRAW_LICENSE_KEY=tldraw-your-license-key

# Required for co-op mode. This publishable key is designed to be used in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Feedback (server only — never prefix secret keys with VITE_).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
RESEND_API_KEY=re_your_key
FEEDBACK_FROM_EMAIL=Change Cards <feedback@jdcasasbuenas.com>
# Shared Safari boards. The secret is server-only; use the same value in the
# Cloudflare Worker (wrangler secret put SAFARI_SYNC_SECRET).
SAFARI_SYNC_URL=
SAFARI_SYNC_SECRET=
